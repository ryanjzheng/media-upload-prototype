{
  "name": "media-upload-plugin",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "manifest.json",
    "src/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "express": "5.1.0",
    "sharp": "0.34.5"
  },
  "peerDependencies": {
    "@databricks/appkit": "0.58.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@databricks/appkit": "0.58.0",
    "@testing-library/react": "16.3.0",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsdown": "0.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.14"
  }
}
